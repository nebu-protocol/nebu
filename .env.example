# Salin ke .env (root). JANGAN commit .env — sudah di .gitignore.

# Rahasia enkripsi private key wallet (AES-256-GCM). String acak panjang.
# Generate: openssl rand -hex 32
LPBOT_KEY_SECRET=

# Private key wallet burner untuk automation (opsional; bisa ditambah lewat UI).
# WALLET_PK=0x...

# Set 1 untuk transaksi ON-CHAIN sungguhan. Kosong/0 = simulasi (default aman).
# EXECUTOR_LIVE=0

# RPC utama (opsional; default public RPC Robinhood Chain). Isi Alchemy/QuickNode untuk throughput.
# ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/KEY

# Domain publik (untuk metadata SEO/OG). Default https://lp.ifajar.dev
# NEXT_PUBLIC_SITE_URL=https://lp.ifajar.dev
