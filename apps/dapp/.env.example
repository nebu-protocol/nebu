# Public origin of the site (canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dynamic.xyz environment ID — https://app.dynamic.xyz/dashboard/developer
# Leave unset to use Dynamic's public sandbox environment.
# NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Extra origins appended to the CSP connect-src (optional, space-separated)
# CSP_CONNECT_EXTRA=

# Sowee Go quote/attest API (apps/api). Default: http://localhost:8080
# NEXT_PUBLIC_SOWEE_API_URL=http://localhost:8080

# HCS audit-trail topic read on invoice pages. Default: the live testnet topic.
# NEXT_PUBLIC_HCS_TOPIC_ID=0.0.10206435

# Set to 1 to render the labeled mock fixtures instead of live Hedera reads.
# Default (unset/0) = live testnet data.
# NEXT_PUBLIC_DEMO_DATA=0
